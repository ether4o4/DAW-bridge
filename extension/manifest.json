{
  "manifest_version": 3,
  "name": "Local BandLab Control Bridge",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Explicitly connect one BandLab Studio tab to your local audio assistant.",
  "permissions": ["storage", "activeTab", "alarms"],
  "host_permissions": ["http://127.0.0.1:17845/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [{ "matches": ["https://www.bandlab.com/*", "https://bandlab.com/*"], "js": ["content.js"], "run_at": "document_idle" }]
}
